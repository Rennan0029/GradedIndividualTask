public class ItemPedido {
    private Produto produto;
    private int quantidade;
    private double precoUnitarioNoMomento;

    public ItemPedido(Produto produto, int quantidade) {
        if (!produto.possuiEstoque(quantidade)) {
            throw new IllegalArgumentException("Sem estoque suficiente de " + produto.getNome());
        }
        this.produto = produto;
        this.quantidade = quantidade;
        this.precoUnitarioNoMomento = produto.getPrecoUnitario();
    }

    public double calcularSubtotal() {
        return precoUnitarioNoMomento * quantidade;
    }

    public Produto getProduto() { return produto; }
    public int getQuantidade() { return quantidade; }
    public double getPrecoUnitarioNoMomento() { return precoUnitarioNoMomento; }
}
