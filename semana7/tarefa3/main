public class Main {
    public static void main(String[] args) {
     
        Produto coxinha = new Produto("P01", "Coxinha de Frango", Categoria.LANCHE, 6.50, 20);
        Produto suco = new Produto("P02", "Suco Natural", Categoria.BEBIDA, 5.00, 15);
        Produto brigadeiro = new Produto("P03", "Brigadeiro", Categoria.DOCE, 3.00, 10);

        System.out.println("--- Criando o Pedido ---");
        Pedido pedido = new Pedido();

        pedido.adicionarItem(coxinha, 2);
        pedido.adicionarItem(suco, 1);

        double totalCalculado = pedido.calcularTotal();
        System.out.printf("Total do Pedido calculado: R$ %.2f\n\n", totalCalculado);

      
        Pagamento pagamento = new Pagamento(FormaPagamento.DINHEIRO, 20.00);

        
        boolean sucesso = pedido.finalizarPedido(pagamento);

      
        if (sucesso) {
            System.out.println("Venda realizada com sucesso!\n");
            pedido.imprimirComprovante();
        }

       
        System.out.println("\n--- Estoque Atualizado ---");
        System.out.println(coxinha.getNome() + ": " + coxinha.getQuantidadeEstoque() + " unidades restantes");
        System.out.println(suco.getNome() + ": " + suco.getQuantidadeEstoque() + " unidades restantes");
    }
}
