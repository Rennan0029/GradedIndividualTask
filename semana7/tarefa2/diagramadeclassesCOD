@startuml
skinparam classAttributeIconSize 0

enum Categoria {
  LANCHE
  BEBIDA
  DOCE
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

class Produto {
  - codigo: String
  - nome: String
  - categoria: Categoria
  - precoUnitario: double
  - quantidadeEstoque: int
  + atualizarEstoque(qtd: int): void
  + possuiEstoque(qtd: int): boolean
}

class ItemPedido {
  - quantidade: int
  - precoUnitarioNoMomento: double
  + calcularSubtotal(): double
}

class Pedido {
  - dataHora: LocalDateTime
  - finalizado: boolean
  + adicionarItem(produto: Produto, quantidade: int): boolean
  + calcularTotal(): double
  + finalizadoComSucesso(): boolean
}

class Pagamento {
  - tipo: FormaPagamento
  - valorPago: double
  + eSuficiente(totalPedido: double): boolean
  + calcularTroco(totalPedido: double): double
}

class Gerente {
  + cadastrarProduto(p: Produto): void
  + alterarPreco(p: Produto, novoPreco: double): void
  + atualizarEstoque(p: Produto, qtd: int): void
}

Pedido "1" *-- "1..*" ItemPedido : contem >
ItemPedido "0..*" --> "1" Produto : referencia >
Pedido "1" -- "0..1" Pagamento : pago por >
Produto --> Categoria
Pagamento --> FormaPagamento
@enduml
